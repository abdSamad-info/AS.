{
  "version": 2,
  "headers": [
    {
      "source": "/(assets|images)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.ts"
    },
    {
      "source": "/((?!api|assets|images|_next|favicon|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
